<UserControl x:Class="Framework.UI.Inputs.SwitchInput"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <Grid>
        <ToggleSwitch IsChecked="{Binding Value}" shadui:ToggleSwitchAssist.RightAlignedContent="True" ToolTip.Tip="{Binding Description}" MinWidth="{Binding MinWidth}">
            <ToggleSwitch.OnContent>
                <TextBlock Text="{Binding Title}"/>
            </ToggleSwitch.OnContent>
            <ToggleSwitch.OffContent>
                <TextBlock Text="{Binding TitleOff}"/>
            </ToggleSwitch.OffContent>
        </ToggleSwitch>
    </Grid>
</UserControl>
