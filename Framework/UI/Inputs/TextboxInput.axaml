<UserControl x:Class="Framework.UI.Inputs.TextboxInput"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <WrapPanel>
        <TextBlock Text="{Binding Title}" MinWidth="100"/>
        <Grid ColumnDefinitions="* Auto">
            <TextBox Text="{Binding Value}" MinWidth="{Binding MinWidth}"/>
            <TextBlock Grid.Column="1" Text="{Binding Unit}"/>
        </Grid>
        <TextBlock Text="{Binding Error}" IsVisible="{Binding Error,Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </WrapPanel>
</UserControl>
