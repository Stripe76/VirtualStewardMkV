<UserControl x:Class="Framework.UI.Inputs.ComboboxInput"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <WrapPanel>
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MinWidth="100"/>
        <ComboBox Classes="Input" ItemsSource="{Binding Items}" SelectedItem="{Binding Value}" MinWidth="{Binding MinWidth}" MaxDropDownHeight="400"/>
    </WrapPanel>
</UserControl>
