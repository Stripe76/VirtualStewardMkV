<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="StackPanel.Toolbar">
        <Setter Property="Margin" Value="5" />
    </Style>
    <Style Selector="WrapPanel.Input">
        <Setter Property="Margin" Value="5,5,0,0" />
    </Style>
    <Style Selector="Button.Input">
        <Setter Property="Margin" Value="5,5,0,0" />
    </Style>
    <Style Selector="RepeatButton.Input">
        <Setter Property="Margin" Value="5,5,0,0" />
    </Style>
    <Style Selector="ToggleButton.Input">
        <Setter Property="Margin" Value="5,5,0,0" />
    </Style>
    <Style Selector="CheckBox.TreeLeaf">
        <Setter Property="Margin" Value="0,3,0,3" />
    </Style>
    <Style Selector="CheckBox.TreeLeaf:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource InfoColor}"/>
    </Style>
    <Style Selector="ComboBox.Input">
        <Setter Property="Margin" Value="5,5,0,0" />
    </Style>
</Styles>
