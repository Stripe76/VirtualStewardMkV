<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:VirtualSteward.Features.Timelines.Classes">

    <ControlTheme TargetType="m:Marker" x:Key="Marker">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Thumb" Width="20" Height="20" Background="{DynamicResource BackgroundColor60}">
            <TextBlock Foreground="{DynamicResource MutedColor}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Title}"/>
          </Border>
        </ControlTemplate>
      </Setter>
  </ControlTheme>
</ResourceDictionary>
