<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="VirtualSteward.Features.Timelines.Controls.TimelineScrub">
    <Panel Margin="195,195,0,0">
        <Ellipse Width="10" Height="10" Fill="ForestGreen" PointerPressed="InputElement_OnPointerPressed"/>
        <!--<TextBlock Text="{Binding Frame}"/>-->
    </Panel>
</UserControl>
