<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="VirtualSteward.Features.CarSelection.Controls.CarsListItem">
    <Grid PointerReleased="Select_MouseUp" Background="{DynamicResource BackgroundColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Rectangle Fill="{DynamicResource SuccessColor60}" Grid.ColumnSpan="3" Opacity="0.4" IsVisible="{Binding IsActive}"/>
        <TextBlock Text="•" Margin="5,0,5,0"/>
        <TextBlock Grid.Column="1" Text="{Binding Model}" Height="22" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="🗙" Foreground="Firebrick" FontWeight="Bold" Margin="0,0,4,0" PointerReleased="Delete_MouseUp"/>
    </Grid></UserControl>
