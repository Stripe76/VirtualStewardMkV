<UserControl x:Class="VirtualSteward.Features.FileTemplates.Controls.FileTemplateInput"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <WrapPanel>
        <TextBlock Text="{Binding Title}" MinWidth="100"/>
        <ComboBox ItemsSource="{Binding FileTemplates}" MinWidth="200" SelectedItem="{Binding Value}"/>
    </WrapPanel>
</UserControl>
