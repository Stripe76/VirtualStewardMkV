<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="VirtualSteward.Pages.Home.Controls.ReplayGroupTreeNode">
    <UserControl.Styles>
    <Style Selector="TextBlock.Selected">
        <Setter Property="Background" Value="{DynamicResource InfoColor60}"/>
    </Style>
    </UserControl.Styles>

    <TextBlock Text="{Binding Title}" PointerReleased="InputElement_OnPointerReleased" Classes.Selected="{Binding IsSelected}"/>
</UserControl>
