<UserControl x:Class="VirtualSteward.Pages.Server.Pages.Server"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VirtualSteward.Pages.Server"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <Design.DataContext>
        <vm:Server/>
    </Design.DataContext>
    <Grid ColumnDefinitions="* 5 *">
        <Grid RowDefinitions="Auto *">
            <ContentControl Content="{Binding ServerStart}"/>
            <ScrollViewer Grid.Row="1" >
                <WrapPanel Orientation="Horizontal">
                    <ContentControl Content="{Binding ServerOptions}"/>
                    <ContentControl Content="{Binding ServerWeather}"/>
                    <ContentControl Content="{Binding ServerPorts}"/>
                </WrapPanel>
            </ScrollViewer>
        </Grid>
        <GridSplitter Grid.Row="0" Grid.Column="1" Width="5" Background="Red"/>
    </Grid>
</UserControl>
