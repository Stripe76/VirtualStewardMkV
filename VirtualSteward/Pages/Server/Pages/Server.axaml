<UserControl x:Class="VirtualSteward.Pages.Server.Pages.Server"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VirtualSteward.Pages.Server"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" Background="{DynamicResource BackgroundColor}">
    <Design.DataContext>
        <vm:Server/>
    </Design.DataContext>
    <Grid ColumnDefinitions="* 6 *">
        <Grid RowDefinitions="Auto *">
            <StackPanel Orientation="Horizontal">
                <SplitButton Classes="Primary" Margin="6,6,0,0" Width="200" Height="48" Content="Start server" Command="{Binding StartServerCommand}">
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="RightEdgeAlignedTop">
                            <MenuItem Header="Start replay" Command="{Binding SetStartReplay}" IsChecked="{Binding StartReplay}"/>
                            <MenuItem Header="Launch CM" Command="{Binding SetLauncCM}" IsChecked="{Binding LaunchCM}"/>
                            <MenuItem Header="Launch AC" Command="{Binding SetLauncAC}" IsEnabled="False" IsChecked="{Binding LaunchAC}"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <ContentControl Content="{Binding ServerStatus}" Padding="16"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <WrapPanel Orientation="Horizontal">
                    <ContentControl Content="{Binding ServerOptions}"/>
                    <ContentControl Content="{Binding ServerWeather}"/>
                    <ContentControl Content="{Binding ServerPorts}"/>
                </WrapPanel>
            </ScrollViewer>
        </Grid>
        <GridSplitter Grid.Row="0" Grid.Column="1" Width="6"/>
        <ContentControl Grid.Column="2" Content="{Binding CarSelection}"/>
    </Grid>
</UserControl>
