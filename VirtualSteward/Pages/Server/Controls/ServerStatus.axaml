<UserControl x:Class="VirtualSteward.Pages.Server.Controls.ServerStatus"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VirtualSteward.Pages.Server.ViewModels"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <Design.DataContext>
        <vm:VMServerStatus/>
    </Design.DataContext>
    
    <UserControl.Styles>
        <Style Selector="shadui|Badge">
            <Setter Property="Background" Value="{DynamicResource MutedColor}"/>
        </Style>
        <Style Selector="HyperlinkButton">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </UserControl.Styles>
    
    <StackPanel Orientation="Horizontal">
        <StackPanel Orientation="Vertical" Spacing="6" Margin="0,6,0,0">
            <shadui:Badge Classes="Secondary" Classes.Success="{Binding IsRunning}" Content="Running">
                <shadui:Badge.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.2"></BrushTransition>
                    </Transitions>
                </shadui:Badge.Transitions>
            </shadui:Badge>
            <shadui:Badge
                Classes="Secondary" Classes.Success="{Binding IsPlaying}" Content="Playing" >
                <shadui:Badge.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    </Transitions>
                </shadui:Badge.Transitions>
            </shadui:Badge>
        </StackPanel>
        <HyperlinkButton IsVisible="{Binding IsRunning}" Command="{Binding LauncCMCommand}" CommandParameter="{Binding ServerLink}" Content="{Binding ServerAddress}"/>
    </StackPanel>
</UserControl>
