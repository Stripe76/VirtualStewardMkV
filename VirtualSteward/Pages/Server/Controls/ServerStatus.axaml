<UserControl x:Class="VirtualSteward.Pages.Server.Controls.ServerStatus"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VirtualSteward.Pages.Server.ViewModels"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <Design.DataContext>
        <vm:VMServerStatus/>
    </Design.DataContext>
    <StackPanel Orientation="Horizontal" Spacing="8">
        <shadui:Badge Classes="Secondary" Content="Starting" IsVisible="{Binding IsStarting}" />
        <shadui:Badge Classes="Success" Content="Running" IsVisible="{Binding IsRunning}" />
        <shadui:Badge Classes.Success="{Binding IsPlaying}" Classes.Destructive="{Binding !IsPlaying}" Content="Playing" IsVisible="{Binding IsRunning}" />
    </StackPanel>
</UserControl>
