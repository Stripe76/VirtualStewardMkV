<UserControl x:Class="VirtualSteward.Pages.Options.Pages.Options"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VirtualSteward.Pages.Options"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" Background="{DynamicResource BackgroundColor}">
    <Design.DataContext>
        <vm:Options/>
    </Design.DataContext>
    <StackPanel>
        <ContentControl Content="{Binding Settings}"/>
    </StackPanel>
</UserControl>
